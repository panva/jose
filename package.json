{
  "name": "jose",
  "version": "6.2.10",
  "description": "JWA, JWS, JWE, JWT, JWK, JWKS for Node.js, Browser, Cloudflare Workers, Deno, Bun, and other Web-interoperable runtimes",
  "keywords": [
    "akp",
    "browser",
    "bun",
    "cloudflare",
    "compact",
    "decode",
    "decrypt",
    "deno",
    "detached",
    "ec",
    "ecdsa",
    "ed25519",
    "eddsa",
    "edge",
    "electron",
    "embedded",
    "encrypt",
    "flattened",
    "general",
    "jose",
    "json web token",
    "jsonwebtoken",
    "jwa",
    "jwe",
    "jwk",
    "jwks",
    "jws",
    "jwt-decode",
    "jwt",
    "ml-dsa",
    "netlify",
    "next",
    "nextjs",
    "oct",
    "okp",
    "payload",
    "pem",
    "pkcs8",
    "rsa",
    "sign",
    "signature",
    "spki",
    "validate",
    "vercel",
    "verify",
    "webcrypto",
    "workerd",
    "workers",
    "x509"
  ],
  "homepage": "https://github.com/panva/jose",
  "repository": "panva/jose",
  "funding": {
    "url": "https://github.com/sponsors/panva"
  },
  "license": "MIT",
  "author": "Filip Skokan <panva.ip@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#dist": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/webapi/index.js"
    },
    "#dist/*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/webapi/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/webapi/index.js"
    },
    "./algorithms/types": null,
    "./algorithms/*": {
      "types": "./dist/types/algorithms/*.d.ts",
      "default": "./dist/webapi/algorithms/*.js"
    },
    "./composable/jwe/types": null,
    "./composable/jws/types": null,
    "./composable/*": {
      "types": "./dist/types/composable/*.d.ts",
      "default": "./dist/webapi/composable/*.js"
    },
    "./jwk/*": {
      "types": "./dist/types/jwk/*.d.ts",
      "default": "./dist/webapi/jwk/*.js"
    },
    "./key/generate/keypair": {
      "types": "./dist/types/key/generate_key_pair.d.ts",
      "default": "./dist/webapi/key/generate_key_pair.js"
    },
    "./key/generate/secret": {
      "types": "./dist/types/key/generate_secret.d.ts",
      "default": "./dist/webapi/key/generate_secret.js"
    },
    "./key/generate_key_pair": null,
    "./key/generate_secret": null,
    "./key/*": {
      "types": "./dist/types/key/*.d.ts",
      "default": "./dist/webapi/key/*.js"
    },
    "./jwks/symbols": null,
    "./jwks/*": {
      "types": "./dist/types/jwks/*.d.ts",
      "default": "./dist/webapi/jwks/*.js"
    },
    "./jwt/decode": {
      "types": "./dist/types/util/decode_jwt.d.ts",
      "default": "./dist/webapi/util/decode_jwt.js"
    },
    "./jwt/*": {
      "types": "./dist/types/jwt/*.d.ts",
      "default": "./dist/webapi/jwt/*.js"
    },
    "./decode/protected_header": {
      "types": "./dist/types/util/decode_protected_header.d.ts",
      "default": "./dist/webapi/util/decode_protected_header.js"
    },
    "./jws/*": {
      "types": "./dist/types/jws/*.d.ts",
      "default": "./dist/webapi/jws/*.js"
    },
    "./jwe/*": {
      "types": "./dist/types/jwe/*.d.ts",
      "default": "./dist/webapi/jwe/*.js"
    },
    "./errors": {
      "types": "./dist/types/util/errors.d.ts",
      "default": "./dist/webapi/util/errors.js"
    },
    "./base64url": {
      "types": "./dist/types/util/base64url.d.ts",
      "default": "./dist/webapi/util/base64url.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/webapi/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist/webapi/**/*.js",
    "dist/types/**/*.d.ts",
    "!dist/**/*.bundle.js",
    "!dist/**/*.umd.js",
    "!dist/**/*.min.js",
    "!dist/webapi/algorithms/types.js",
    "!dist/webapi/composable/jwe/types.js",
    "!dist/webapi/lib/key_descriptor.js",
    "!dist/types/lib/**"
  ],
  "scripts": {
    "build": "tsc && node tools/annotate-pure.js && node tools/minify-syntax.js && node tools/check-composer-names.js",
    "build-all": "run-s clear build build:*",
    "build:bundle": "esbuild --bundle dist/webapi/index.js --format=esm --target=es2022 --outfile=dist/webapi/index.bundle.js",
    "build:bundle-min": "esbuild --minify --bundle dist/webapi/index.js --format=esm --target=es2022 --outfile=dist/webapi/index.bundle.min.js",
    "build:umd": "esbuild --bundle dist/webapi/index.js --format=iife --global-name=jose --target=es2022 --outfile=dist/webapi/index.umd.js && node tools/iife-to-umd.cjs dist/webapi/index.umd.js && esbuild --minify dist/webapi/index.umd.js --outfile=dist/webapi/index.umd.min.js",
    "build:types": "tsc -p ./tsconfig/types.json && cd src && find . -name '*.d.ts' -type f -exec rsync -R \"{}\" ../dist/types  \\; && cd .. && node tools/declaration-comments.js",
    "build:jsr": "npx --yes jsr publish --dry-run --allow-dirty",
    "clear": "rm -Rf dist",
    "docs": "node ./tools/docs.cjs",
    "docs:generate": "typedoc",
    "types:find": "find dist/types -name '*.d.ts' -type f -print0",
    "test": "bash -c 'source .node_flags.sh && ava'",
    "format": "prettier --log-level silent --write ./test ./tap ./test-d ./src ./tools ./cookbook ./tsconfig",
    "tap:browsers": "./tap/.browsers.sh",
    "tap:bun": "./tap/.bun.sh",
    "tap:deno": "./tap/.deno.sh",
    "tap:electron": "./tap/.electron.sh",
    "tap:llrt": "./tap/.llrt.sh",
    "tap:node": "bash -c './tap/.node.sh'",
    "tap:workerd": "./tap/.workerd.sh",
    "typecheck:tap": "tsc -p tap",
    "typecheck:types": "tsc -p test-d && tsc -p test-d/tsconfig.fallback.json",
    "typecheck:dist": "./tools/typecheck-dist.sh",
    "check:subpaths": "node tools/check-subpaths.js",
    "check:treeshaking": "node tools/check-treeshaking.js",
    "check:bundles": "node tools/bundle-report.js --check",
    "check:packaging": "publint --strict && node tools/attw-check.js && node tools/check-package-exports.js"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/qunit": "^2.19.14",
    "ava": "^7.0.0",
    "esbuild": "^0.28.1",
    "fast-check": "^4.9.0",
    "hpke": "^1.1.5",
    "npm-run-all2": "^9.0.3",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.8.1",
    "publint": "0.3.21",
    "qunit": "^2.26.0",
    "tar": "^7.5.22",
    "timekeeper": "^2.3.1",
    "ts-blank-space": "^0.9.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typescript": "^6.0.3",
    "undici": "^7.29.0"
  }
}
