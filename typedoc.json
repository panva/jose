{
  "$schema": "https://typedoc-plugin-markdown.org/schema.json",
  "logLevel": "Warn",
  "treatWarningsAsErrors": true,
  "disableSources": true,
  "hideBreadcrumbs": true,
  "entryPoints": [
    "src/types.d.ts",
    "src/algorithms/jws.ts",
    "src/algorithms/key.ts",
    "src/algorithms/jwe.ts",
    "src/algorithms/jwe/enc.ts",
    "src/algorithms/jwe/zip.ts",
    "src/composable/jwt/sign.ts",
    "src/composable/jwt/verify.ts",
    "src/composable/jwt/encrypt.ts",
    "src/composable/jwt/decrypt.ts",
    "src/composable/jws/compact/sign.ts",
    "src/composable/jws/compact/verify.ts",
    "src/composable/jws/flattened/sign.ts",
    "src/composable/jws/flattened/verify.ts",
    "src/composable/jws/general/sign.ts",
    "src/composable/jws/general/verify.ts",
    "src/composable/jwe/compact/encrypt.ts",
    "src/composable/jwe/compact/decrypt.ts",
    "src/composable/jwe/flattened/encrypt.ts",
    "src/composable/jwe/flattened/decrypt.ts",
    "src/composable/jwe/general/encrypt.ts",
    "src/composable/jwe/general/decrypt.ts",
    "src/composable/jwk/embedded.ts",
    "src/composable/jwks/local.ts",
    "src/composable/jwks/remote.ts",
    "src/composable/key/import.ts",
    "src/composable/key/generate/keypair.ts",
    "src/composable/key/generate/secret.ts",
    "src/jwe/**/*.ts",
    "src/jwk/*.ts",
    "src/jwks/local.ts",
    "src/jwks/remote.ts",
    "src/jws/**/*.ts",
    "src/jwt/*.ts",
    "src/key/*.ts",
    "src/util/*.ts"
  ],
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "intentionallyNotExported": [
    "src/algorithms/types.ts:AlgorithmFactory",
    "src/algorithms/types.ts:AlgorithmOf",
    "src/algorithms/types.ts:C",
    "src/algorithms/types.ts:JWEAlgorithmCapability",
    "src/algorithms/types.ts:JWECompressionCapability",
    "src/algorithms/types.ts:JWEContentEncryptionCapability",
    "src/algorithms/types.ts:JWEKeyManagementCapability",
    "src/algorithms/types.ts:JWSAlgorithmCapability",
    "src/algorithms/types.ts:K",
    "src/algorithms/types.ts:KeyAlgorithmCapability",
    "src/algorithms/types.ts:S",
    "src/algorithms/types.ts:UniqueAlgorithmFactories",
    "src/algorithms/types.ts:ValidJWSAlgorithmSelection"
  ],
  "gitRevision": "main",
  "hideGenerator": true,
  "out": "docs",
  "plugin": ["typedoc-plugin-markdown", "typedoc-plugin-mdn-links"],
  "readme": "none",
  "sort": ["kind", "static-first", "required-first", "alphabetical"],
  "githubPages": false,
  "parametersFormat": "table",
  "indexFormat": "table",
  "pageTitleTemplates": {
    "member": "{keyword} {kind}: {name}\n\n## [💗 Help the project](https://github.com/sponsors/panva)\n\nSupport from the community to continue maintaining and improving this module is welcome. If you find the module useful, please consider supporting the project by [becoming a sponsor](https://github.com/sponsors/panva)."
  },
  "hidePageHeader": true
}
